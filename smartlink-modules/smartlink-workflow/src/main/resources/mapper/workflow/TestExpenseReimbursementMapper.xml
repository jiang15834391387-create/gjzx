<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.smartlink.workflow.mapper.TestExpenseReimbursementMapper">
        <update id="delBatchById" >
            update `test_expense_reimbursement`
            set `is_deleted` = 1,update_by=#{userId},update_time=NOW()
            where id in
            <foreach collection="list" item="val" separator="," open="(" close=")">
                #{val}
            </foreach>
        </update>
</mapper>
