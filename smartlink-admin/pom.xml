            <artifactId>smartlink-system</artifactId>
        </dependency>

        <dependency>
            <groupId>org.smartlink</groupId>
            <artifactId>smartlink-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.smartlink</groupId>
            <artifactId>smartlink-job</artifactId>
        </dependency>

        <!-- 代码生成-->
        <dependency>
            <groupId>org.smartlink</groupId>
            <artifactId>smartlink-generator</artifactId>
        </dependency>

        <!--  demo模块  -->
        <dependency>
            <groupId>org.smartlink</groupId>
            <artifactId>smartlink-demo</artifactId>
        </dependency>

        <!--  工作流模块  -->
        <dependency>
            <groupId>org.smartlink</groupId>
            <artifactId>smartlink-workflow</artifactId>
        </dependency>

        <dependency>
            <groupId>de.codecentric</groupId>
            <artifactId>spring-boot-admin-starter-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- skywalking 整合 logback -->
        <!--        <dependency>-->
        <!--            <groupId>org.apache.skywalking</groupId>-->
        <!--            <artifactId>apm-toolkit-logback-1.x</artifactId>-->
